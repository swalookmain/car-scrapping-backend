<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 11px; color: #111; padding: 16px 18px; }
    h1 { text-align: center; font-size: 13px; margin-bottom: 12px; }
    .section { font-weight: bold; margin: 14px 0 6px; text-transform: uppercase; font-size: 12px; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
    th, td { border: 1px solid #222; padding: 8px 6px; vertical-align: top; }
    th { background: #f0f0f0; font-size: 10px; }
    td.empty { height: 28px; }
    .cert { margin-top: 24px; line-height: 1.7; }
    .sign-row { display: flex; justify-content: space-between; margin-top: 36px; }
    .seal {
      width: 140px; height: 90px; border: 2px solid #333; border-radius: 50%;
      display: flex; align-items: center; justify-content: center; text-align: center;
      font-size: 10px; font-weight: bold;
    }
  </style>
</head>
<body>
  <h1>FORM-3 (continued) — To be filled by facility</h1>

  <div class="section">4. Quality Certifications Status</div>
  <table>
    <thead>
      <tr>
        <th style="width:8%">#</th>
        <th>Quality Certifications Status</th>
        <th style="width:25%">Validity</th>
        <th style="width:30%">Remarks</th>
      </tr>
    </thead>
    <tbody>
      <tr><td>A</td><td>ISO 9001</td><td class="empty"></td><td class="empty"></td></tr>
      <tr><td>B</td><td>ISO 14001</td><td class="empty"></td><td class="empty"></td></tr>
      <tr><td>C</td><td>ISO 45001</td><td class="empty"></td><td class="empty"></td></tr>
      <tr><td></td><td class="empty"></td><td class="empty"></td><td class="empty"></td></tr>
    </tbody>
  </table>

  <div class="section">5. Audit</div>
  <table>
    <tbody>
      <tr><td style="width:20%"><strong>A. AGENCY</strong></td><td class="empty"></td></tr>
      <tr><td><strong>B. DATE</strong></td><td class="empty"></td></tr>
      <tr>
        <td><strong>C. RESULT</strong></td>
        <td>PASS &nbsp;&nbsp;&nbsp; FAIL &nbsp;&nbsp;&nbsp; RESUBMIT</td>
      </tr>
    </tbody>
  </table>

  <div class="section">6. Safety</div>
  <table>
    <thead>
      <tr>
        <th style="width:8%">#</th>
        <th>Safety Category</th>
        <th style="width:15%">Nos</th>
        <th style="width:35%">Remarks</th>
      </tr>
    </thead>
    <tbody>
      <tr><td>A</td><td>ACCIDENTS</td><td class="empty"></td><td class="empty"></td></tr>
      <tr><td>B</td><td>INCIDENTS</td><td class="empty"></td><td class="empty"></td></tr>
      <tr><td></td><td class="empty"></td><td class="empty"></td><td class="empty"></td></tr>
    </tbody>
  </table>

  <div class="section">7. Certification</div>
  <div class="cert">
    I _______________________________ DESIGNATION _______________________________
    hereby certify that the data submitted above is a true and accurate reflection of the activities
    of the company for the financial year {{header.financialYear}}.
  </div>

  <div class="sign-row">
    <div>
      <div>Signature: _______________________________</div>
      <div style="margin-top:16px">Place: _______________________________</div>
    </div>
    <div class="seal">COMPANY SEAL<br/><br/>DATE</div>
  </div>
</body>
</html>
