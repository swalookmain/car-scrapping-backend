MONGO_URI=mongodb://localhost:27017/scrap

JWT_SECRET=change-me
JWT_ACCESS_EXPIRY=2d
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRY=7d

PORT=5000
NODE_ENV=development

# Comma-separated frontend origins for CORS (website + ERP). Leave unset for local (reflect any origin).
# ALLOWED_ORIGINS=https://scrapniti.com,https://app.scrapniti.com,http://localhost:3002,http://localhost:5174

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# Storage: cloudinary | s3
STORAGE_PROVIDER=s3

# S3 (STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=scrapniti-uploads
# Optional aliases / overrides:
# AWS_S3_BUCKET=
# AWS_S3_PUBLIC_BASE_URL=https://your-bucket.s3.us-east-1.amazonaws.com

# Cloudinary (STORAGE_PROVIDER=cloudinary)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Optional: custom Chromium path for Puppeteer PDF generation (Windows example)
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
